default_platform(:ios)

platform :ios do
  desc "Capture App Store screenshots via the AppUITests target"
  lane :screenshots do
    # `fastlane snapshot` issues `xcodebuild ... build test` (both action
    # verbs together), which fails on this project's UI test target with
    # "Supported platforms for the buildables in the current scheme is
    # empty." Running the plain `test` action (which builds implicitly)
    # works fine, so we drive xcodebuild ourselves instead of using `snapshot`.
    devices = {
      "iPhone 17 Pro Max" => "6.9-Display",
      "iPad Pro 13-inch (M5)" => "13-Display"
    }
    project_root = File.expand_path("..", __dir__)
    workspace_path = File.join(project_root, "ios/App/App.xcworkspace")
    cache_screenshots_dir = File.expand_path("~/Library/Caches/tools.fastlane/screenshots")
    output_dir = File.join(project_root, "fastlane/screenshots/de-DE")
    derived_data_path = File.join(project_root, "fastlane/DerivedData")

    sh("rm -rf '#{cache_screenshots_dir}'")
    sh("mkdir -p '#{cache_screenshots_dir}' '#{output_dir}'")
    sh("rm -rf '#{derived_data_path}'")

    devices.each do |device_name, folder|
      udid = sh("xcrun simctl list devices available -j | ruby -rjson -e '
        data = JSON.parse(STDIN.read)
        data[\"devices\"].each do |_, list|
          list.each { |d| puts d[\"udid\"] if d[\"name\"] == \"#{device_name}\" }
        end
      ' | head -n1").strip

      sh("xcrun simctl boot '#{udid}' 2>/dev/null || true")

      sh(
        "xcodebuild " \
        "-workspace '#{workspace_path}' " \
        "-scheme AppUITests " \
        "-derivedDataPath '#{derived_data_path}' " \
        "-destination 'platform=iOS Simulator,id=#{udid}' " \
        "test"
      )

      device_output_dir = File.join(output_dir, folder)
      sh("mkdir -p '#{device_output_dir}'")
      sh("mv '#{cache_screenshots_dir}'/*.png '#{device_output_dir}'/ 2>/dev/null || true")
    end

    UI.success("Screenshots saved to #{output_dir}")
  end

  desc "Upload App Store metadata and screenshots (no binary)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "ch.hively.app",
      skip_binary_upload: true,
      skip_app_version_update: true,
      skip_metadata: ENV["SKIP_METADATA"] == "true",
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || latest_testflight_build_number(api_key: api_key) + 1
    )

    if ENV["VERSION_NUMBER"]
      increment_version_number(
        xcodeproj: "ios/App/App.xcodeproj",
        version_number: ENV["VERSION_NUMBER"]
      )
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_ch.hively.app_appstore_profile-name"],
      targets: ["App"],
      build_configurations: ["Release"]
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "ch.hively.app" => ENV["sigh_ch.hively.app_appstore_profile-name"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Build the Android app and upload it to the Play Store internal testing track"
  lane :beta do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/",
      properties: {
        "android.injected.version.code" => (ENV["ANDROID_VERSION_CODE"] || "1").to_i,
        "android.injected.version.name" => ENV["ANDROID_VERSION_NAME"] || "0.0.1"
      }
    )

    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      package_name: "ch.hively.app",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
