default_platform(:ios)

# Shared App Store Connect API key — supports CI (ASC_KEY_CONTENT base64) and local (ASC_KEY_FILEPATH).
def asc_api_key
  if ENV["ASC_KEY_CONTENT"].to_s != ""
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
  elsif ENV["ASC_KEY_FILEPATH"].to_s != ""
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )
  else
    UI.user_error!("Set ASC_KEY_CONTENT (base64) or ASC_KEY_FILEPATH for App Store Connect API access.")
  end
end

IOS_APP_INFO_FILES = %w[
  name.txt subtitle.txt description.txt keywords.txt
  promotional_text.txt privacy_url.txt support_url.txt
].freeze

ANDROID_LISTING_FILES = %w[
  title.txt short_description.txt full_description.txt
].freeze

# Copy only selected locale folders so deliver/supply do not try to create
# store languages that are not enabled yet (e.g. while a version is in review).
def stage_ios_metadata_for_upload
  allowed = (ENV["STORE_IOS_LOCALES"] || "de-DE").split(",").map(&:strip)
  src = File.expand_path("metadata", __dir__)
  dst = File.expand_path("metadata_ios_upload", __dir__)
  sh("rm -rf '#{dst}' && mkdir -p '#{dst}'")
  %w[copyright.txt primary_category.txt secondary_category.txt].each do |file|
    path = File.join(src, file)
    sh("cp '#{path}' '#{dst}/'") if File.exist?(path)
  end
  allowed.each do |locale|
    locale_src = File.join(src, locale)
    next unless File.directory?(locale_src)

    locale_dst = File.join(dst, locale)
    sh("mkdir -p '#{locale_dst}'")
    IOS_APP_INFO_FILES.each do |file|
      from = File.join(locale_src, file)
      sh("cp '#{from}' '#{locale_dst}/'") if File.exist?(from)
    end
  end
  dst
end

def stage_android_metadata_for_upload
  allowed = (ENV["STORE_ANDROID_LOCALES"] || "de-DE,fr-FR,it-IT,en-US").split(",").map(&:strip)
  src = File.expand_path("metadata/android", __dir__)
  dst = File.expand_path("metadata_android_upload", __dir__)
  sh("rm -rf '#{dst}' && mkdir -p '#{dst}'")
  allowed.each do |locale|
    locale_src = File.join(src, locale)
    next unless File.directory?(locale_src)

    locale_dst = File.join(dst, locale)
    sh("mkdir -p '#{locale_dst}'")
    ANDROID_LISTING_FILES.each do |file|
      from = File.join(locale_src, file)
      sh("cp '#{from}' '#{locale_dst}/'") if File.exist?(from)
    end

    # Copy per-locale changelogs and store images so supply can upload them
    # when the corresponding skip flags are disabled.
    changelogs_src = File.join(locale_src, "changelogs")
    sh("cp -R '#{changelogs_src}' '#{locale_dst}/'") if File.directory?(changelogs_src)
    images_src = File.join(locale_src, "images")
    sh("cp -R '#{images_src}' '#{locale_dst}/'") if File.directory?(images_src)
  end
  dst
end

# Stage only ASC locale folders (exclude fastlane/screenshots/android/) so
# deliver never treats Android captures as an App Store locale.
#
# deliver expects a *flat* per-locale layout (`de-DE/*.png`). Device subfolders
# like `6.9-Display/` from our capture lane are ignored — which looks like a
# successful upload of 0 screenshots. Flatten framed (preferred) or raw PNGs.
def stage_ios_screenshots_for_upload
  src = File.expand_path("screenshots", __dir__)
  dst = File.expand_path("screenshots_ios_upload", __dir__)
  sh("rm -rf '#{dst}' && mkdir -p '#{dst}'")
  locales = (ENV["STORE_IOS_LOCALES"] || "de-DE").split(",").map(&:strip)
  total = 0
  locales.each do |locale|
    locale_src = File.join(src, locale)
    next unless File.directory?(locale_src)

    locale_dst = File.join(dst, locale)
    sh("mkdir -p '#{locale_dst}'")

    framed = Dir[File.join(locale_src, "**", "*_framed.png")]
    pngs = framed.empty? ? Dir[File.join(locale_src, "**", "*.png")] : framed
    pngs.each do |png|
      # Keep basename so deliver can use the "iPhone 17 Pro Max-…" device hint.
      dest_name = File.basename(png)
      # Avoid collisions when the same basename appears in multiple device folders.
      dest = File.join(locale_dst, dest_name)
      if File.exist?(dest)
        parent = File.basename(File.dirname(png))
        dest = File.join(locale_dst, "#{parent}-#{dest_name}")
      end
      FileUtils.cp(png, dest)
    end
    count = Dir[File.join(locale_dst, "*.png")].length
    UI.user_error!(
      "No iOS screenshots to stage for #{locale} under #{locale_src} " \
      "(expected flat de-DE/*.png or de-DE/**/*_framed.png)"
    ) if count < 1
    total += count
    UI.message("Staged #{count} screenshot(s) → #{locale_dst}/ (flat for deliver)")
  end
  UI.user_error!("No iOS screenshot locales staged") if total < 1
  dst
end

platform :ios do
  desc "Capture App Store screenshots via the AppUITests target"
  lane :screenshots do
    # `fastlane snapshot` issues `xcodebuild ... build test` (both action
    # verbs together), which fails on this project's UI test target with
    # "Supported platforms for the buildables in the current scheme is
    # empty." Running the plain `test` action (which builds implicitly)
    # works fine, so we drive xcodebuild ourselves instead of using `snapshot`.
    devices = {
      "iPhone 17 Pro Max" => "6.9-Display",
      "iPad Pro 13-inch (M5)" => "13-Display"
    }
    project_root = File.expand_path("..", __dir__)
    workspace_path = File.join(project_root, "ios/App/App.xcworkspace")
    cache_screenshots_dir = File.expand_path("~/Library/Caches/tools.fastlane/screenshots")
    output_dir = File.join(project_root, "fastlane/screenshots/de-DE")
    derived_data_path = File.join(project_root, "fastlane/DerivedData")

    sh("rm -rf '#{cache_screenshots_dir}'")
    sh("mkdir -p '#{cache_screenshots_dir}' '#{output_dir}'")
    sh("rm -rf '#{derived_data_path}'")

    devices.each do |device_name, folder|
      udid = sh("xcrun simctl list devices available -j | ruby -rjson -e '
        data = JSON.parse(STDIN.read)
        data[\"devices\"].each do |_, list|
          list.each { |d| puts d[\"udid\"] if d[\"name\"] == \"#{device_name}\" }
        end
      ' | head -n1").strip

      sh("xcrun simctl boot '#{udid}' 2>/dev/null || true")

      # Pre-grant location so the "Bienen-Radar" weather prompt never covers a
      # screenshot. Best-effort: ignore if the app isn't installed yet.
      sh("xcrun simctl privacy '#{udid}' grant location 'ch.hively.app' 2>/dev/null || true")

      # `snapshot()` writes each PNG as it runs, so keep going even if xcodebuild
      # reports a test failure (Xcode 26 raises the UIScene-lifecycle notice as a
      # test issue, and slow simulators occasionally trip a wait). Whether the
      # run produced the expected screenshots is verified below.
      test_ok = system(
        "xcodebuild " \
        "-workspace '#{workspace_path}' " \
        "-scheme AppUITests " \
        "-derivedDataPath '#{derived_data_path}' " \
        "-destination 'platform=iOS Simulator,id=#{udid}' " \
        "test"
      )
      UI.important("xcodebuild test reported a failure for #{device_name}; checking screenshots anyway.") unless test_ok

      device_output_dir = File.join(output_dir, folder)
      sh("mkdir -p '#{device_output_dir}'")
      sh("mv '#{cache_screenshots_dir}'/*.png '#{device_output_dir}'/ 2>/dev/null || true")

      captured = Dir[File.join(device_output_dir, "*.png")].length
      UI.user_error!("#{device_name}: expected 5 screenshots, got #{captured}") if captured < 5
    end

    UI.success("Screenshots saved to #{output_dir}")
  end

  desc "Add device frames + ASO overlay text to captured screenshots (frameit)"
  lane :frame_shots do
    project_root = File.expand_path("..", __dir__)
    screenshots_dir = File.join(project_root, "fastlane/screenshots")
    UI.user_error!("No screenshots found in #{screenshots_dir}. Run `fastlane ios screenshots` first.") unless File.directory?(screenshots_dir)

    # frameit silently skips the title/keyword overlay when no background image
    # is present, producing framed-but-textless screenshots. Fail loudly instead.
    background = File.join(screenshots_dir, "background.jpg")
    UI.user_error!("Missing #{background} — frameit needs it to render the overlay text.") unless File.exist?(background)

    # frameit resolves `background` (and picks up the .strings) relative to the
    # directory of the screenshots it is framing, not the Framefile. Stage the
    # config into every per-device folder so the overlay text renders.
    Dir[File.join(screenshots_dir, "*/*-Display")].each do |device_dir|
      locale_dir = File.dirname(device_dir)
      sh("cp '#{background}' '#{device_dir}/'")
      ["Framefile.json"].each do |f|
        src = File.join(screenshots_dir, f)
        sh("cp '#{src}' '#{device_dir}/'") if File.exist?(src)
      end
      ["title.strings", "keyword.strings"].each do |f|
        src = File.join(locale_dir, f)
        sh("cp '#{src}' '#{device_dir}/'") if File.exist?(src)
      end
    end

    frame_screenshots(
      path: screenshots_dir,
      use_platform: "IOS"
    )

    # Drop the staged copies again so only the framed PNGs remain to commit.
    Dir[File.join(screenshots_dir, "*/*-Display")].each do |device_dir|
      ["background.jpg", "Framefile.json", "title.strings", "keyword.strings"].each do |f|
        FileUtils.rm_f(File.join(device_dir, f))
      end
    end
    UI.success("Framed screenshots written next to the originals in #{screenshots_dir}")
  end

  desc "Fail unless committed iOS screenshots exist for STORE_IOS_LOCALES (no capture)"
  lane :verify_existing_screenshots do
    project_root = File.expand_path("..", __dir__)
    screenshots_dir = File.join(project_root, "fastlane/screenshots")
    locales = (ENV["STORE_IOS_LOCALES"] || "de-DE").split(",").map(&:strip)
    total = 0
    locales.each do |locale|
      locale_dir = File.join(screenshots_dir, locale)
      UI.user_error!("Missing iOS screenshot locale folder: #{locale_dir}") unless File.directory?(locale_dir)
      framed = Dir[File.join(locale_dir, "**", "*_framed.png")]
      any = Dir[File.join(locale_dir, "**", "*.png")]
      count = framed.length > 0 ? framed.length : any.length
      UI.user_error!(
        "Need ≥5 iOS screenshots under #{locale_dir} (found #{count}). " \
        "Commit *_framed.png e.g. #{locale}/6.9-Display/ or run `fastlane ios screenshots`."
      ) if count < 5
      total += count
    end
    UI.success("Found #{total} iOS screenshot PNG(s) for #{locales.join(', ')}")
  end

  desc "Upload App Store listing text + screenshots from fastlane/metadata/ (no binary)"
  lane :upload_metadata do
    metadata_path = stage_ios_metadata_for_upload
    upload_shots = ENV["SKIP_SCREENSHOTS"] == "false"
    # Default false: overwrite clears ALL ASC screenshot sizes for the locale,
    # then uploads only what's local (e.g. wiping iPad if only 6.9" is in repo).
    # Set OVERWRITE_SCREENSHOTS=true when uploading a complete device matrix.
    overwrite = ENV["OVERWRITE_SCREENSHOTS"] == "true"
    screenshots_path = nil
    begin
      if upload_shots
        screenshots_path = stage_ios_screenshots_for_upload
        staged = Dir[File.join(screenshots_path, "**", "*.png")]
        UI.user_error!("No iOS screenshots staged under #{screenshots_path}") if staged.empty?
      end
      deliver(
        api_key: asc_api_key,
        app_identifier: "ch.hively.app",
        metadata_path: metadata_path,
        screenshots_path: screenshots_path,
        skip_binary_upload: true,
        skip_app_version_update: true,
        skip_metadata: ENV["SKIP_METADATA"] == "true",
        skip_screenshots: !upload_shots,
        overwrite_screenshots: overwrite,
        run_precheck_before_submit: false,
        force: true
      )
    ensure
      sh("rm -rf '#{metadata_path}'")
      sh("rm -rf '#{screenshots_path}'") if screenshots_path
    end
  end

  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || latest_testflight_build_number(api_key: api_key) + 1
    )

    if ENV["VERSION_NUMBER"]
      # App Store Connect: CFBundleShortVersionString must be at most 3 integers
      # (e.g. 1.2.3). Four-part tags like 0.6.9.2 are rejected at upload.
      raw = ENV["VERSION_NUMBER"].to_s.strip
      parts = raw.split(".").map { |p| Integer(p) }
      if parts.length < 1 || parts.length > 3
        UI.user_error!(
          "VERSION_NUMBER '#{raw}' is invalid for iOS. " \
          "Use at most three period-separated integers (e.g. 0.6.10), not four (e.g. 0.6.9.2)."
        )
      end
      marketing = parts.join(".")
      ENV["VERSION_NUMBER"] = marketing
      increment_version_number(
        xcodeproj: "ios/App/App.xcodeproj",
        version_number: marketing
      )
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_ch.hively.app_appstore_profile-name"],
      targets: ["App"],
      build_configurations: ["Release"]
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "ch.hively.app" => ENV["sigh_ch.hively.app_appstore_profile-name"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Stage committed Android screenshots into Play phoneScreenshots/ (no capture)"
  lane :verify_existing_screenshots do
    project_root = File.expand_path("..", __dir__)
    play_dir = File.join(project_root, "fastlane/metadata/android/de-DE/images/phoneScreenshots")
    framed_dir = File.join(project_root, "fastlane/screenshots/android/de-DE/phone")
    FileUtils.mkdir_p(play_dir)

    play_pngs = Dir[File.join(play_dir, "*.png")]
    if play_pngs.empty?
      framed = Dir[File.join(framed_dir, "*_framed.png")]
      if framed.empty?
        # Also accept unframed captures already sitting in the phone folder.
        raw = Dir[File.join(framed_dir, "*.png")]
        if raw.empty?
          if ENV["ALLOW_MISSING_SCREENSHOTS"] == "true"
            UI.important(
              "No Android phone screenshots in repo — skipping " \
              "(ALLOW_MISSING_SCREENSHOTS=true). Commit PNGs under #{play_dir} later."
            )
            next
          end
          UI.user_error!(
            "No Android phone screenshots found.\n" \
            "  Expected PNGs in #{play_dir}\n" \
            "  or *_framed.png under #{framed_dir}\n" \
            "Run `fastlane android screenshots` + `frame_shots`, or commit the Play images."
          )
        end
        raw.each { |src| FileUtils.cp(src, File.join(play_dir, File.basename(src))) }
      else
        framed.each do |src|
          base = File.basename(src, "_framed.png") + ".png"
          FileUtils.cp(src, File.join(play_dir, base))
        end
      end
      play_pngs = Dir[File.join(play_dir, "*.png")]
    end

    count = play_pngs.length
    UI.user_error!("Android phoneScreenshots still empty after staging") if count < 1
    UI.user_error!(
      "Play phone screenshots: need 2–8 PNGs in #{play_dir} (found #{count})"
    ) if count < 2 || count > 8
    UI.success("Found #{count} Android phone screenshot(s) in #{play_dir}")
  end

  desc "Capture Play Store phone screenshots via ScreenshotCaptureTest (needs emulator/device)"
  lane :screenshots do
    project_root = File.expand_path("..", __dir__)
    out_dir = File.join(project_root, "fastlane/screenshots/android/de-DE/phone")
    logcat_path = File.join(project_root, "fastlane/screenshots/android/logcat-screenshots.txt")
    FileUtils.rm_rf(out_dir)
    FileUtils.mkdir_p(out_dir)
    FileUtils.mkdir_p(File.dirname(logcat_path))

    # Install debug APK first so pm grant targets a real package, then quiet UI.
    gradle(task: "installDebug", project_dir: "android/")
    sh("adb shell settings put global window_animation_scale 0 || true")
    sh("adb shell settings put global transition_animation_scale 0 || true")
    sh("adb shell settings put global animator_duration_scale 0 || true")
    sh("adb shell pm grant ch.hively.app android.permission.ACCESS_FINE_LOCATION || true")
    sh("adb shell pm grant ch.hively.app android.permission.ACCESS_COARSE_LOCATION || true")
    sh("adb logcat -c || true")

    begin
      gradle(
        task: "connectedDebugAndroidTest",
        project_dir: "android/",
        flags: "-Pandroid.testInstrumentationRunnerArguments.class=ch.hively.app.ScreenshotCaptureTest"
      )
    rescue => e
      sh("adb logcat -d -v time > '#{logcat_path}' || true")
      UI.important("Saved emulator logcat to #{logcat_path}")
      raise e
    end

    device_path = "/sdcard/Android/data/ch.hively.app/files/Pictures/store-screenshots"
    sh("adb pull '#{device_path}/.' '#{out_dir}/'")

    captured = Dir[File.join(out_dir, "*.png")].reject { |p| p.include?("_framed") }.length
    UI.user_error!("Android screenshots: expected 5 PNGs, got #{captured} in #{out_dir}") if captured < 5
    UI.success("Screenshots saved to #{out_dir}")
  end

  desc "Add device frames + ASO overlay text, copy into Play phoneScreenshots/"
  lane :frame_shots do
    project_root = File.expand_path("..", __dir__)
    screenshots_root = File.join(project_root, "fastlane/screenshots")
    phone_dir = File.join(screenshots_root, "android/de-DE/phone")
    ios_locale_dir = File.join(screenshots_root, "de-DE")
    background = File.join(screenshots_root, "background.jpg")
    framefile = File.join(screenshots_root, "Framefile.json")

    UI.user_error!("No screenshots in #{phone_dir}. Run `fastlane android screenshots` first.") unless File.directory?(phone_dir)
    raw = Dir[File.join(phone_dir, "*.png")].reject { |p| p.include?("_framed") }
    UI.user_error!("No raw PNGs in #{phone_dir}") if raw.empty?
    UI.user_error!("Missing #{background} — frameit needs it for overlay text.") unless File.exist?(background)

    # Stage frameit config next to the PNGs (same pattern as ios frame_shots).
    sh("cp '#{background}' '#{phone_dir}/'")
    sh("cp '#{framefile}' '#{phone_dir}/'") if File.exist?(framefile)
    %w[title.strings keyword.strings].each do |f|
      src = File.join(ios_locale_dir, f)
      sh("cp '#{src}' '#{phone_dir}/'") if File.exist?(src)
    end

    frame_screenshots(
      path: File.join(screenshots_root, "android"),
      use_platform: "ANDROID"
    )

    %w[background.jpg Framefile.json title.strings keyword.strings].each do |f|
      FileUtils.rm_f(File.join(phone_dir, f))
    end

    play_dir = File.join(project_root, "fastlane/metadata/android/de-DE/images/phoneScreenshots")
    FileUtils.mkdir_p(play_dir)
    Dir[File.join(play_dir, "*.png")].each { |p| FileUtils.rm_f(p) }

    framed = Dir[File.join(phone_dir, "*_framed.png")]
    UI.user_error!("frameit produced no *_framed.png in #{phone_dir}") if framed.empty?
    framed.each do |src|
      # Play listing order is alphabetical — drop the _framed suffix for cleaner names.
      base = File.basename(src, "_framed.png") + ".png"
      FileUtils.cp(src, File.join(play_dir, base))
    end

    UI.success("Framed screenshots → #{play_dir} (#{framed.length} files)")
  end

  desc "Upload Play Store listing text from fastlane/metadata/android/ (no binary)"
  lane :upload_metadata do
    track = ENV["PLAY_METADATA_TRACK"] || "internal"
    version_codes = google_play_track_version_codes(
      track: track,
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      package_name: "ch.hively.app"
    )
    version_code = version_codes.map(&:to_i).max
    UI.user_error!("No Play Store release found on track '#{track}'") if version_code.nil? || version_code <= 0

    metadata_path = stage_android_metadata_for_upload
    begin
      upload_to_play_store(
        metadata_path: metadata_path,
        track: track,
        version_code: version_code,
        json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
        package_name: "ch.hively.app",
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: ENV["SKIP_METADATA"] == "true",
        skip_upload_changelogs: ENV["SKIP_CHANGELOGS"] == "true",
        skip_upload_images: ENV["SKIP_STORE_IMAGES"] != "false",
        skip_upload_screenshots: ENV["SKIP_STORE_SCREENSHOTS"] != "false"
      )
    ensure
      sh("rm -rf '#{metadata_path}'")
    end
  end

  desc "Build the Android app and upload it to the Play Store internal testing track"
  lane :beta do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/",
      properties: {
        "android.injected.version.code" => (ENV["ANDROID_VERSION_CODE"] || "1").to_i,
        "android.injected.version.name" => ENV["ANDROID_VERSION_NAME"] || "0.0.1"
      }
    )

    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
      package_name: "ch.hively.app",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
