# Copy to `.env` and fill in values. Never commit `.env`.

# Supabase (exposed to the browser — anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini (server-only — Vite middleware + Netlify Function)
# Do NOT prefix with VITE_ (that would embed the key in the client bundle).
GEMINI_API_KEY=your-gemini-api-key

# Optional: absolute Gemini proxy URL for Capacitor/iOS builds.
# Defaults to https://hivelyy.netlify.app/api/gemini when unset.
# VITE_GEMINI_PROXY_URL=https://hivelyy.netlify.app/api/gemini

# Optional: PostHog analytics (absent → no tracking). Prefer EU host for CH/EU.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Optional session replay (default off; masks inputs/text when enabled):
# VITE_POSTHOG_SESSION_REPLAY=true
# Mark all events as test traffic (localhost/dev already tagged automatically):
# VITE_POSTHOG_TEST_MODE=true

# Stripe / Hively Pro (server-only secrets — never prefix with VITE_)
# Go-live checklist (Live Price IDs + Netlify steps): docs/billing/stripe-go-live.md
#
# Local / sandbox:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...   # sandbox monthly
# STRIPE_PRICE_YEARLY=price_...    # sandbox yearly
#
# Production (Netlify) — Live IDs already created:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  # from Live webhook endpoint
# STRIPE_PRICE_MONTHLY=price_1U3VXP0S42cslpuh5F6WpV4X
# STRIPE_PRICE_YEARLY=price_1U3VXQ0S42cslpuhykxIJ1uu
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # webhook writes plan fields (bypasses RLS)
# APP_ORIGIN=http://localhost:5173   # success/cancel URLs (prod: https://hivelyy.netlify.app)
# Soft-locks (client) AND hard-gates (Gemini/Stripe) require the same flag:
# VITE_BILLING_ENABLED=true
# Optional alias for Netlify Functions (same meaning):
# BILLING_ENABLED=true
# Optional native absolute API origin for Capacitor:
# VITE_STRIPE_API_ORIGIN=https://hivelyy.netlify.app
# Also apply supabase/migration_billing_stripe.sql + migration_billing_hardening.sql
# + migration_billing_rls_complete.sql. Enable Pro RLS at go-live:
#   supabase/migration_billing_gates_go_live.sql
# Durable Gemini rate limits (optional, service_role):
#   supabase/migration_api_rate_limits.sql
