# Copy to `.env` and fill in values. Never commit `.env`.

# Supabase (exposed to the browser — anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini (server-only — Vite middleware + Netlify Function)
# Do NOT prefix with VITE_ (that would embed the key in the client bundle).
GEMINI_API_KEY=your-gemini-api-key

# Optional: absolute Gemini proxy URL for Capacitor/iOS builds.
# Defaults to https://hivelyy.netlify.app/api/gemini when unset.
# VITE_GEMINI_PROXY_URL=https://hivelyy.netlify.app/api/gemini

# Optional: PostHog analytics (absent → no tracking). Prefer EU host for CH/EU.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Optional session replay (default off; masks inputs/text when enabled):
# VITE_POSTHOG_SESSION_REPLAY=true
