{
  "name": "bee-tracker",
  "version": "0.6.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ota:set-channel": "node scripts/set-ota-channel.mjs",
    "ota:publish": "node scripts/ota-publish.mjs",
    "ios:sync": "npm run build && PATH=\"/opt/homebrew/bin:$PATH\" npx cap sync ios",
    "ios:pods": "cd ios/App && pod install",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@capgo/cli": "^8.47.0",
    "@playwright/test": "^1.62.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.1",
    "@capgo/capacitor-updater": "^8.51.15",
    "@google/generative-ai": "^0.24.1",
    "@netlify/blobs": "^11.0.3",
    "@supabase/supabase-js": "^2.115.0",
    "posthog-js": "^1.427.1",
    "stripe": "^22.6.1"
  }
}
